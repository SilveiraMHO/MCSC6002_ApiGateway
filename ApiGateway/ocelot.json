{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TokenSettings": {
    "PublicKeyPath": "../../keys/jwt-public.pem"
  },
  "Routes": [
    {
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "" // Anonymous.
      },

      "DownstreamPathTemplate": "/api/token/login",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7284
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/auth/refresh-token",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "" // Anonymous: token expected expired; Identity validates it.
      },

      "DownstreamPathTemplate": "/api/token/refresh-token",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7284
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/auth/revoke-token",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer" // Any signed-in user; revokes only their own token.
      },
      "ForwardedHeaders": {
        "Authorization": "Authorization"
      },

      "DownstreamPathTemplate": "/api/token/revoke",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7284
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/identity/users/create",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "RouteClaimsRequirement": { // Rechecked in the service.
        "permission": "Permission.Identity.Users.Create"
      },
      "ForwardedHeaders": {
        "Authorization": "Authorization"
      },

      "DownstreamPathTemplate": "/api/users/create",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7284
        }
      ]
    },
    {
