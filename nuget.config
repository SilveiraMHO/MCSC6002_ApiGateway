<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="nuget-local" />
  </packageSources>
  <!-- AuthLibrary and ResponseLibrary come only from nuget-local. nuget.org has unrelated packages with the same names. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="AuthLibrary" />
      <package pattern="ResponseLibrary" />
    </packageSource>
  </packageSourceMapping>
</configuration>
